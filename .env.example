# ---------------------------------------------------------------------------
# Spotless Ops — environment
#
# Copy to .env.local and fill in. NOTHING in this file is required to run the
# app in demo mode: `npm run dev` with DEMO_MODE=1 serves the whole admin UI
# from in-memory fixtures with no external service at all.
#
# NEVER commit real keys. NEVER paste a secret into an issue, PR, or chat.
# ---------------------------------------------------------------------------

# Fixtures instead of Supabase. Unset means "demo unless Supabase is
# configured", so filling in the Supabase block below is enough to go live.
# DEMO_MODE=1 forces fixtures even with credentials present (useful for demos);
# DEMO_MODE=0 forces the real path and fails loudly if config is missing.
DEMO_MODE=1

# --- Supabase (build plan phase 1) -----------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Bypasses row-level security — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (phase 3) — blocked on underwriting ----------------------------
# Billing is OFF until STRIPE_SECRET_KEY is set. BILLING_ENABLED=0 forces it off
# even with keys present (useful while underwriting is pending); =1 forces it on.
# DEMO_MODE=1 always wins, so a demo can never reach a live card.
BILLING_ENABLED=0
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
# From `stripe listen` locally, or the endpoint's signing secret in the
# dashboard. Without it /api/stripe/webhook refuses every event rather than
# trusting an unverified body.
STRIPE_WEBHOOK_SECRET=

# --- Twilio (phase 6) — blocked on A2P 10DLC carrier approval, 1-3 weeks ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

# --- Scheduled work --------------------------------------------------------
# Shared secret for the cron endpoints (/api/billing/autocharge today, the
# phase-6 automation engine next). They run with no signed-in user, so this is
# the only thing standing in front of them. Generate with:
#   openssl rand -hex 32
# With it unset the endpoints refuse every request — they fail closed.
CRON_SECRET=

# --- App -------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=https://app.heyspotless.com
